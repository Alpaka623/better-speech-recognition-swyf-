<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs outside the game, loaded by install.ps1 in Windows PowerShell 5.1 (.NET Framework 4.x), so it
    ships as a DLL instead of an .exe.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>BetterSpeech.Patcher</AssemblyName>
    <RootNamespace>BetterSpeech.Patcher</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
